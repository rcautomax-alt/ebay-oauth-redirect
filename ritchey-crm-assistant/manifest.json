{
  "manifest_version": 3,
  "name": "Ritchey CRM Assistant",
  "version": "0.3.0",
  "description": "Reads VinSolutions follow-up tasks, checks the vehicle against live inventory, and drafts Manager Special price quotes for review. Never sends.",
  "permissions": ["sidePanel", "scripting", "storage", "tabs", "activeTab"],
  "host_permissions": [
    "https://*.vinsolutions.com/*",
    "https://*.vinmanager.com/*",
    "https://*.coxautoinc.com/*",
    "https://www.ritcheybuickgmc.com/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "src/sidepanel/sidepanel.html"
  },
  "action": {
    "default_title": "Ritchey CRM Assistant"
  }
}
